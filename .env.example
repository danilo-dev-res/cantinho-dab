# Copie este arquivo para ".env" e troque pelos dados do SEU projeto no Supabase.

# Project URL (Supabase → botão "Connect", ou Project Settings → Data API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Publishable key (Project Settings → API Keys). Começa com sb_publishable_
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# O e-mail do usuário que você criou em Authentication → Users
VITE_COUPLE_EMAIL=dab@nossocantinho.com
